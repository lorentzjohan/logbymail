# Line endings: LF in the repository and in every working copy, Windows included.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never converted
*.mo   binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.zip  binary

# Development files: not included in the release archives (git archive)
/.github                  export-ignore
/docs                     export-ignore
/tests                    export-ignore
/tools                    export-ignore
/.gitattributes           export-ignore
/.gitignore               export-ignore
/.php-cs-fixer.php        export-ignore
/.twig_cs.dist.php        export-ignore
/phpstan.neon             export-ignore
/phpunit.xml              export-ignore
/psalm.xml                export-ignore
/rector.php               export-ignore
/Makefile                 export-ignore
/.sonarcloud.properties   export-ignore
